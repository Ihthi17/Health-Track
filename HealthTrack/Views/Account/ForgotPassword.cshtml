@model HealthTrack.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="mb-3 text-center">
    <h5 style="color: #2D3E47; font-weight: 700; margin-bottom: 8px;">Reset your password</h5>
    <p class="text-muted small" style="margin: 0;">Enter your email address and we'll send you a password reset link</p>
</div>

@{
    var statusMessage = ViewData["StatusMessage"]?.ToString();
}

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle me-2"></i>
        @statusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (ViewData.ModelState.Keys.Any(k => ViewData.ModelState[k].Errors.Count > 0))
{
    <div class="alert alert-danger">
        <div asp-validation-summary="ModelOnly"></div>
    </div>
}

<form asp-action="ForgotPassword" method="post" novalidate>
    <div class="mb-3">
        <label asp-for="Email" class="form-label">
            <i class="fas fa-envelope me-2" style="color: #16A6A1;"></i>Email Address
        </label>
        <input asp-for="Email" class="form-control" placeholder="your@email.com" type="email" required />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <button type="submit" class="btn-primary-auth" style="margin-bottom: 12px;">
        <i class="fas fa-paper-plane me-2"></i> Send Reset Link
    </button>

    <div class="auth-links">
        <span style="color: #6B7F89;">Remember your password?</span>
        <a asp-action="Login">
            <i class="fas fa-sign-in-alt me-1"></i> Sign in
        </a>
    </div>
</form>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}
