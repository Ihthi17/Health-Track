@{
    Layout = null;
}

@inject HealthTrack.Services.SystemSettingsService _settingsService

@{
    var systemName = _settingsService.GetSystemName() ?? "HealthTrack";
    var systemLogo = _settingsService.GetSystemLogo();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @systemName</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --primary-dark: #123B4A;
            --accent-teal: #16A6A1;
            --bg-light: #F3F7F8;
            --text-dark: #2D3E47;
            --text-muted: #6B7F89;
            --border-light: #E0EBF0;
            --white: #FFFFFF;
            --danger: #DC3545;
            --success: #28A745;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, var(--primary-dark) 0%, rgba(18, 59, 74, 0.95) 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
        }

        .auth-container {
            width: 100%;
            max-width: 440px;
        }

        .auth-card {
            background: var(--white);
            border: none;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            overflow: hidden;
        }

        .auth-header {
            background: linear-gradient(135deg, var(--primary-dark) 0%, rgba(18, 59, 74, 0.95) 100%);
            color: var(--white);
            padding: 40px 30px;
            text-align: center;
            border-bottom: 1px solid var(--border-light);
        }

        .auth-logo {
            width: 60px;
            height: 60px;
            margin: 0 auto 15px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .auth-logo img {
            max-width: 90%;
            max-height: 90%;
            object-fit: contain;
        }

        .auth-logo-icon {
            font-size: 2rem;
            color: var(--accent-teal);
        }

        .auth-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 8px;
            color: var(--white);
        }

        .auth-subtitle {
            font-size: 0.9rem;
            opacity: 0.9;
            color: var(--white);
        }

        .card-body {
            padding: 40px 30px;
        }

        .form-label {
            font-weight: 600;
            color: var(--text-dark);
            font-size: 0.95rem;
            margin-bottom: 8px;
        }

        .form-control {
            border: 1px solid var(--border-light);
            border-radius: 8px;
            padding: 11px 14px;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            background-color: var(--white);
        }

        .form-control:focus {
            border-color: var(--accent-teal);
            box-shadow: 0 0 0 3px rgba(22, 166, 161, 0.1);
            background-color: var(--white);
        }

        .form-check-input {
            width: 18px;
            height: 18px;
            margin-top: 4px;
            cursor: pointer;
            border: 1px solid var(--border-light);
        }

        .form-check-input:checked {
            background-color: var(--accent-teal);
            border-color: var(--accent-teal);
        }

        .form-check-label {
            cursor: pointer;
            color: var(--text-dark);
            font-weight: 500;
            font-size: 0.95rem;
        }

        .btn-primary-auth {
            background: linear-gradient(135deg, var(--accent-teal) 0%, #1a9692 100%);
            color: var(--white);
            border: none;
            padding: 11px 20px;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
            font-size: 0.95rem;
            width: 100%;
            margin-top: 8px;
        }

        .btn-primary-auth:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(22, 166, 161, 0.3);
            color: var(--white);
        }

        .btn-outline-auth {
            background: var(--white);
            color: var(--accent-teal);
            border: 2px solid var(--accent-teal);
            padding: 9px 18px;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
            font-size: 0.95rem;
            width: 100%;
            margin-top: 8px;
        }

        .btn-outline-auth:hover {
            background: var(--accent-teal);
            color: var(--white);
            transform: translateY(-2px);
        }

        .btn-outline-secondary {
            border: 1px solid var(--border-light);
            color: var(--text-muted);
            border-radius: 6px;
            padding: 8px 12px;
            font-size: 0.85rem;
        }

        .btn-outline-secondary:hover {
            background-color: var(--bg-light);
            color: var(--text-dark);
        }

        .input-group .btn-outline-secondary {
            border-left: none;
        }

        .input-group .form-control:focus + .btn-outline-secondary {
            border-color: var(--accent-teal);
        }

        .validation-summary-errors {
            background-color: rgba(220, 53, 69, 0.1);
            border: 1px solid rgba(220, 53, 69, 0.3);
            border-radius: 8px;
            padding: 12px;
            margin-bottom: 20px;
            color: #721c24;
        }

        .text-danger {
            color: var(--danger) !important;
            font-size: 0.85rem;
            margin-top: 4px;
            display: block;
        }

        .alert {
            border-radius: 8px;
            border: none;
            margin-bottom: 20px;
            padding: 12px 16px;
        }

        .alert-info {
            background-color: rgba(23, 162, 184, 0.1);
            color: #0c5460;
            border-left: 4px solid #17A2B8;
        }

        .alert-success {
            background-color: rgba(40, 167, 69, 0.1);
            color: #155724;
            border-left: 4px solid #28A745;
        }

        .alert-danger {
            background-color: rgba(220, 53, 69, 0.1);
            color: #721c24;
            border-left: 4px solid #DC3545;
        }

        .mb-3 {
            margin-bottom: 20px;
        }

        .auth-links {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 20px;
            font-size: 0.9rem;
        }

        .auth-links a {
            color: var(--accent-teal);
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .auth-links a:hover {
            color: var(--primary-dark);
            text-decoration: underline;
        }

        .text-center {
            text-align: center;
        }

        .small {
            font-size: 0.85rem;
        }

        .card-footer {
            background-color: var(--bg-light);
            border-top: 1px solid var(--border-light);
            padding: 20px;
            text-align: center;
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        .position-relative {
            position: relative;
        }

        @@media (max-width: 480px) {
            .auth-header {
                padding: 30px 20px;
            }

            .card-body {
                padding: 30px 20px;
            }

            .auth-title {
                font-size: 1.25rem;
            }

            .auth-links {
                flex-direction: column;
                gap: 12px;
            }
        }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <div class="auth-logo">
                    @if (!string.IsNullOrEmpty(systemLogo))
                    {
                        <img src="@systemLogo" alt="@systemName" />
                    }
                    else
                    {
                        <i class="fas fa-heartbeat auth-logo-icon"></i>
                    }
                </div>
                <div class="auth-title">@systemName</div>
            </div>

            <div class="card-body">
                @RenderBody()
            </div>

            <div class="card-footer">
                &copy; @DateTime.Now.Year @systemName. All rights reserved.
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
