@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Dashboard Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Admin Dashboard</h2>
            <p class="text-muted mb-0">
                Welcome to HealthTrack Administration.
                Manage users, trainers, and health services.
            </p>
        </div>

        <span class="badge bg-success-subtle text-success px-3 py-2 mt-2">
            <i class="bi bi-circle-fill me-1"></i> System Dashboard
        </span>
    </div>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-2">Total Users</p>
                            <h3 class="fw-bold mb-0">@ViewBag.TotalUsers</h3>
                            <small class="text-muted">Registered accounts</small>
                        </div>
                        <div class="rounded-3 bg-primary-subtle text-primary p-3">
                            <i class="bi bi-people fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-2">Clients</p>
                            <h3 class="fw-bold mb-0">@ViewBag.TotalClients</h3>
                            <small class="text-muted">Client accounts</small>
                        </div>
                        <div class="rounded-3 bg-success-subtle text-success p-3">
                            <i class="bi bi-person-check fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-2">Roles</p>
                            <h3 class="fw-bold mb-0">@ViewBag.TotalRoles</h3>
                            <small class="text-muted">System roles</small>
                        </div>
                        <div class="rounded-3 bg-info-subtle text-info p-3">
                            <i class="bi bi-shield-check fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-2">System Status</p>
                            <h3 class="fw-bold mb-0 text-success">Online</h3>
                            <small class="text-muted">All systems operational</small>
                        </div>
                        <div class="rounded-3 bg-warning-subtle text-warning p-3">
                            <i class="bi bi-check-circle fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Management Section -->
    <div class="row g-4 mb-4">

        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-1">User Management</h5>
                    <p class="text-muted small mb-0">
                        Manage HealthTrack user accounts and roles.
                    </p>
                </div>

                <div class="card-body p-4">
                    <div class="row g-3">

                        <div class="col-12 col-md-6">
                            <div class="border rounded-3 p-3 h-100">
                                <i class="bi bi-people fs-3 text-primary"></i>
                                <h6 class="fw-bold mt-3">All Users</h6>
                                <p class="text-muted small">
                                    View and manage registered accounts.
                                </p>
                                <a asp-controller="Users"
                                   asp-action="Index"
                                   class="btn btn-outline-primary btn-sm">
                                    Manage Users
                                </a>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="border rounded-3 p-3 h-100">
                                <i class="bi bi-person-workspace fs-3 text-info"></i>
                                <h6 class="fw-bold mt-3">Trainer Management</h6>
                                <p class="text-muted small">
                                    Create trainer accounts and manage invitations.
                                </p>
                                <a asp-controller="Trainers"
                                   asp-action="Index"
                                   class="btn btn-outline-primary btn-sm">
                                    Manage Trainers
                                </a>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="border rounded-3 p-3 h-100">
                                <i class="bi bi-person-plus fs-3 text-success"></i>
                                <h6 class="fw-bold mt-3">Create User</h6>
                                <p class="text-muted small">
                                    Add a Client, Trainer, or authorized Admin.
                                </p>
                                <a asp-controller="Users"
                                   asp-action="Create"
                                   class="btn btn-outline-primary btn-sm">
                                    Create User
                                </a>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="border rounded-3 p-3 h-100">
                                <i class="bi bi-calendar2-check fs-3 text-warning"></i>
                                <h6 class="fw-bold mt-3">Appointments</h6>
                                <p class="text-muted small">
                                    Review and manage scheduled appointments.
                                </p>
                                <a asp-controller="Appointments"
                                   asp-action="Index"
                                   class="btn btn-outline-primary btn-sm">
                                    View Appointments
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Information -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0">Administration</h5>
                </div>

                <div class="card-body px-4">
                    <div class="d-flex align-items-start mb-4">
                        <i class="bi bi-shield-check text-success fs-4 me-3"></i>
                        <div>
                            <h6 class="fw-semibold mb-1">Access Control</h6>
                            <p class="text-muted small mb-0">
                                Restrict administrative operations to authorized roles.
                            </p>
                        </div>
                    </div>

                    <div class="d-flex align-items-start mb-4">
                        <i class="bi bi-person-lock text-primary fs-4 me-3"></i>
                        <div>
                            <h6 class="fw-semibold mb-1">Account Security</h6>
                            <p class="text-muted small mb-0">
                                Manage account status and secure password setup.
                            </p>
                        </div>
                    </div>

                    <div class="d-flex align-items-start">
                        <i class="bi bi-journal-text text-warning fs-4 me-3"></i>
                        <div>
                            <h6 class="fw-semibold mb-1">Audit Logs</h6>
                            <p class="text-muted small mb-0">
                                Review recorded administrative actions.
                            </p>
                            <a asp-controller="AuditLogs"
                               asp-action="Index"
                               class="small">
                                View audit logs
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Recent Activity -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 pt-4 px-4">
            <h5 class="fw-bold mb-1">Recent Activity</h5>
            <p class="text-muted small mb-0">
                Latest administrative actions and system events.
            </p>
        </div>

        <div class="card-body p-4">
            @if (ViewBag.RecentLogs != null && ((List<HealthTrack.Models.AuditLog>)ViewBag.RecentLogs).Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Timestamp</th>
                                <th>Action</th>
                                <th>Details</th>
                                <th>Performed By</th>
                                <th>IP Address</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in (List<HealthTrack.Models.AuditLog>)ViewBag.RecentLogs)
                            {
                                <tr>
                                    <td><small>@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</small></td>
                                    <td>
                                        @switch (log.Action)
                                        {
                                            case "UserCreate":
                                                <span class="badge bg-success">User Create</span>
                                                break;
                                            case "UserEdit":
                                                <span class="badge bg-info">User Edit</span>
                                                break;
                                            case "UserDelete":
                                                <span class="badge bg-danger">User Delete</span>
                                                break;
                                            case "RoleCreate":
                                                <span class="badge bg-success">Role Create</span>
                                                break;
                                            case "SettingsEdit":
                                                <span class="badge bg-secondary">Settings</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@log.Action</span>
                                                break;
                                        }
                                    </td>
                                    <td><small>@log.Details</small></td>
                                    <td><small>@log.PerformedBy</small></td>
                                    <td><small>@log.IPAddress</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="bi bi-clock-history fs-1 text-muted"></i>
                    <p class="text-muted mt-3 mb-0">
                        No activity recorded yet.
                    </p>
                </div>
            }
        </div>
    </div>

</div>
