@model IEnumerable<HealthTrack.Models.AuditLog>

@{
    ViewData["Title"] = "Audit Logs";
    Layout = "~/Views/Shared/_SuperAdminLayout.cshtml";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalRecords = ViewBag.TotalRecords ?? 0;
    string searchQuery = ViewBag.SearchQuery ?? "";
    int startRecord = ((currentPage - 1) * pageSize) + 1;
    int endRecord = Math.Min(currentPage * pageSize, totalRecords);
}

<div class="audit-logs">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">System Audit Logs</h5>
                <div class="text-white-50 small">
                    @if (totalRecords > 0)
                    {
                        <span>Showing @startRecord-@endRecord of @totalRecords records</span>
                    }
                </div>
            </div>
        </div>
        <div class="card-body">
            <!-- Search and Filters -->
            <form method="get" action="/superadmin/audit-logs" class="mb-4">
                <div class="row">
                    <div class="col-md-6">
                        <input type="text" name="search" class="form-control" placeholder="Search by action, details, or user..." value="@searchQuery">
                    </div>
                    <div class="col-md-2">
                        <select name="pageSize" class="form-select" id="pageSizeSelect">
                            <option value="5">5 per page</option>
                            <option value="10">10 per page</option>
                            <option value="25">25 per page</option>
                            <option value="50">50 per page</option>
                            <option value="100">100 per page</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-search"></i> Search
                        </button>
                    </div>
                    <div class="col-md-2">
                        <a href="/superadmin/audit-logs" class="btn btn-secondary w-100">
                            <i class="fas fa-redo"></i> Reset
                        </a>
                    </div>
                </div>
            </form>

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Timestamp</th>
                                <th>Action</th>
                                <th>Details</th>
                                <th>Performed By</th>
                                <th>IP Address</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model)
                            {
                                <tr>
                                    <td>@log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td>
                                        @switch (log.Action)
                                        {
                                            case "UserCreate":
                                                <span class="badge bg-success">User Create</span>
                                                break;
                                            case "UserEdit":
                                                <span class="badge bg-info">User Edit</span>
                                                break;
                                            case "UserDelete":
                                                <span class="badge bg-danger">User Delete</span>
                                                break;
                                            case "RoleCreate":
                                                <span class="badge bg-success">Role Create</span>
                                                break;
                                            case "RoleEdit":
                                                <span class="badge bg-info">Role Edit</span>
                                                break;
                                            case "SettingsEdit":
                                                <span class="badge bg-secondary">Settings</span>
                                                break;
                                            case "AppointmentCreate":
                                                <span class="badge bg-success">Appointment Create</span>
                                                break;
                                            case "AppointmentEdit":
                                                <span class="badge bg-info">Appointment Edit</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@log.Action</span>
                                                break;
                                        }
                                    </td>
                                    <td>@log.Details</td>
                                    <td>@log.PerformedBy</td>
                                    <td><small>@log.IPAddress</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Controls -->
                @if (totalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <div class="text-muted small">
                            Showing <strong>@Model.Count()</strong> of @totalRecords records (Page @currentPage of @totalPages)
                        </div>
                        <nav aria-label="Page navigation">
                            <ul class="pagination mb-0">
                                <!-- First Button -->
                                @if (currentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="/superadmin/audit-logs?page=1&pageSize=@pageSize@(string.IsNullOrEmpty(searchQuery) ? "" : $"&search={System.Web.HttpUtility.UrlEncode(searchQuery)}")">
                                            <i class="fas fa-step-backward"></i>
                                        </a>
                                    </li>
                                }

                                <!-- Previous Button -->
                                @if (currentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="/superadmin/audit-logs?page=@(currentPage - 1)&pageSize=@pageSize@(string.IsNullOrEmpty(searchQuery) ? "" : $"&search={System.Web.HttpUtility.UrlEncode(searchQuery)}")">
                                            <i class="fas fa-chevron-left"></i>
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">
                                            <i class="fas fa-chevron-left"></i>
                                        </span>
                                    </li>
                                }

                                <!-- Page Numbers -->
                                @{
                                    int startPage = Math.Max(1, currentPage - 2);
                                    int endPage = Math.Min(totalPages, currentPage + 2);
                                }

                                @if (startPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="/superadmin/audit-logs?page=1&pageSize=@pageSize@(string.IsNullOrEmpty(searchQuery) ? "" : $"&search={System.Web.HttpUtility.UrlEncode(searchQuery)}")">1</a>
                                    </li>
                                    @if (startPage > 2)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                }

                                @for (int i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                        <a class="page-link" href="/superadmin/audit-logs?page=@i&pageSize=@pageSize@(string.IsNullOrEmpty(searchQuery) ? "" : $"&search={System.Web.HttpUtility.UrlEncode(searchQuery)}")">@i</a>
                                    </li>
                                }

                                @if (endPage < totalPages)
                                {
                                    @if (endPage < totalPages - 1)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                    <li class="page-item">
                                        <a class="page-link" href="/superadmin/audit-logs?page=@totalPages&pageSize=@pageSize@(string.IsNullOrEmpty(searchQuery) ? "" : $"&search={System.Web.HttpUtility.UrlEncode(searchQuery)}")">@totalPages</a>
                                    </li>
                                }

                                <!-- Next Button -->
                                @if (currentPage < totalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="/superadmin/audit-logs?page=@(currentPage + 1)&pageSize=@pageSize@(string.IsNullOrEmpty(searchQuery) ? "" : $"&search={System.Web.HttpUtility.UrlEncode(searchQuery)}")">
                                            <i class="fas fa-chevron-right"></i>
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">
                                            <i class="fas fa-chevron-right"></i>
                                        </span>
                                    </li>
                                }

                                <!-- Last Button -->
                                @if (currentPage < totalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="/superadmin/audit-logs?page=@totalPages&pageSize=@pageSize@(string.IsNullOrEmpty(searchQuery) ? "" : $"&search={System.Web.HttpUtility.UrlEncode(searchQuery)}")">
                                            <i class="fas fa-step-forward"></i>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> No audit logs found.
                </div>
            }
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const pageSizeSelect = document.getElementById('pageSizeSelect');
        if (pageSizeSelect) {
            pageSizeSelect.value = @pageSize;
            pageSizeSelect.addEventListener('change', function() {
                const searchParam = document.querySelector('input[name=search]').value;
                const url = '/superadmin/audit-logs?page=1&pageSize=' + this.value + (searchParam ? '&search=' + encodeURIComponent(searchParam) : '');
                location.href = url;
            });
        }
    });
</script>
