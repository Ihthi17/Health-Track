@model IEnumerable<HealthTrack.Models.Role>

@{
    ViewData["Title"] = "Role Management";
    Layout = "~/Views/Shared/_SuperAdminLayout.cshtml";
}

<div class="roles-management">
    <div class="mb-4">
        <a href="/superadmin/roles/create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Create New Role
        </a>
        <a href="/superadmin/permissions" class="btn btn-info">
            <i class="fas fa-lock"></i> Manage Permissions
        </a>
    </div>

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">System Roles</h5>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Role Name</th>
                                <th>Description</th>
                                <th>Permissions</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var role in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@role.RoleName</strong>
                                    </td>
                                    <td>@(role.Description ?? "-")</td>
                                    <td>
                                        @if (role.Permissions != null && role.Permissions.Any())
                                        {
                                            <div class="permissions-list">
                                                @foreach (var perm in role.Permissions.Take(3))
                                                {
                                                    <span class="badge bg-secondary">@perm.PermissionName</span>
                                                }
                                                @if (role.Permissions.Count > 3)
                                                {
                                                    <span class="badge bg-secondary">+@(role.Permissions.Count - 3)</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No permissions</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="/superadmin/roles/edit/@role.RoleID" class="btn btn-sm btn-warning">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <!-- Feature B: Permission Toggles -->
                                        <button type="button" class="btn btn-sm btn-info" data-bs-toggle="modal" data-bs-target="#permModal_@role.RoleID">
                                            <i class="fas fa-lock"></i> Permissions
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> No roles found.
                </div>
            }
        </div>
    </div>
</div>

<style>
    .permissions-list {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
    }

    .permissions-list .badge {
        font-size: 11px;
        padding: 4px 8px;
    }
</style>

<!-- Feature B: Permission Toggle Modals -->
@if (Model != null)
{
    @foreach (var role in Model)
    {
        <div class="modal fade" id="permModal_@role.RoleID" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header bg-info text-white">
                        <h5 class="modal-title">Manage Permissions for @role.RoleName</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <form method="post" action="/superadmin/roles/@role.RoleID/permissions">
                        <div class="modal-body">
                            @{
                                // Get all permissions (requires query in view - ideally passed via ViewBag)
                                var allPermissions = ViewBag.AllPermissions as List<HealthTrack.Models.Permission> ?? new List<HealthTrack.Models.Permission>();
                                var rolePermIds = role.Permissions?.Select(p => p.PermissionID).ToHashSet() ?? new HashSet<int>();
                            }
                            @if (allPermissions.Any())
                            {
                                <div class="permissions-container">
                                    @foreach (var perm in allPermissions.OrderBy(p => p.Module).ThenBy(p => p.PermissionName))
                                    {
                                        <div class="permission-toggle">
                                            <input type="checkbox" class="form-check-input" id="perm_@perm.PermissionID" 
                                                   name="permissionIds" value="@perm.PermissionID" 
                                                   @(rolePermIds.Contains(perm.PermissionID) ? "checked" : "")>
                                            <label class="form-check-label flex-grow-1" for="perm_@perm.PermissionID">
                                                <span class="badge bg-secondary">@(perm.Module ?? "General")</span>
                                                <strong>@perm.PermissionName</strong>
                                                @if (!string.IsNullOrEmpty(perm.Description))
                                                {
                                                    <small class="text-muted d-block">@perm.Description</small>
                                                }
                                            </label>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning">
                                    <i class="fas fa-exclamation-circle"></i> No permissions available. Create permissions first.
                                </div>
                            }
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Save Permissions</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}

<style>
    .permission-toggle {
        display: flex;
        gap: 10px;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid #eee;
    }

    .permission-toggle:last-child {
        border-bottom: none;
    }
</style>
