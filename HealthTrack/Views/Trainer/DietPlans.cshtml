@{
    ViewData["Title"] = "Diet Plans";
    Layout = "~/Views/Shared/_TrainerLayout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3">Diet Plans</h1>
            <p class="text-muted">Create and manage nutrition plans for your clients</p>
        </div>
        <div>
            <a href="#" class="btn btn-primary me-2" data-bs-toggle="modal" data-bs-target="#createDietModal">
                <i class="fas fa-plus me-2"></i> New Diet Plan
            </a>
            <a href="/trainer" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Diet Plans Grid -->
    <div class="row">
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-light border-0">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="mb-1">High Protein Diet</h6>
                            <small class="text-muted">For: John Doe</small>
                        </div>
                        <span class="badge bg-success">Active</span>
                    </div>
                </div>
                <div class="card-body">
                    <p class="mb-2"><strong>Duration:</strong> 12 weeks</p>
                    <p class="mb-2"><strong>Daily Calories:</strong> 2,800 kcal</p>
                    <p class="mb-3"><strong>Goal:</strong> Muscle Building</p>
                    <div class="mb-3">
                        <p class="small text-muted mb-2">Macronutrients:</p>
                        <div class="progress mb-2" style="height: 20px;">
                            <div class="progress-bar" style="width: 40%; background-color: #FF6B6B;">40% Protein</div>
                        </div>
                        <div class="progress mb-2" style="height: 20px;">
                            <div class="progress-bar" style="width: 35%; background-color: #4ECDC4;">35% Carbs</div>
                        </div>
                        <div class="progress" style="height: 20px;">
                            <div class="progress-bar" style="width: 25%; background-color: #95E1D3;">25% Fats</div>
                        </div>
                    </div>
                    <div class="d-grid gap-2">
                        <button class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-edit me-1"></i> Edit Plan
                        </button>
                        <button class="btn btn-sm btn-outline-danger">
                            <i class="fas fa-trash me-1"></i> Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-light border-0">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="mb-1">Calorie Deficit Diet</h6>
                            <small class="text-muted">For: Jane Smith</small>
                        </div>
                        <span class="badge bg-success">Active</span>
                    </div>
                </div>
                <div class="card-body">
                    <p class="mb-2"><strong>Duration:</strong> 16 weeks</p>
                    <p class="mb-2"><strong>Daily Calories:</strong> 2,000 kcal</p>
                    <p class="mb-3"><strong>Goal:</strong> Weight Loss</p>
                    <div class="mb-3">
                        <p class="small text-muted mb-2">Macronutrients:</p>
                        <div class="progress mb-2" style="height: 20px;">
                            <div class="progress-bar" style="width: 35%; background-color: #FF6B6B;">35% Protein</div>
                        </div>
                        <div class="progress mb-2" style="height: 20px;">
                            <div class="progress-bar" style="width: 45%; background-color: #4ECDC4;">45% Carbs</div>
                        </div>
                        <div class="progress" style="height: 20px;">
                            <div class="progress-bar" style="width: 20%; background-color: #95E1D3;">20% Fats</div>
                        </div>
                    </div>
                    <div class="d-grid gap-2">
                        <button class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-edit me-1"></i> Edit Plan
                        </button>
                        <button class="btn btn-sm btn-outline-danger">
                            <i class="fas fa-trash me-1"></i> Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-light border-0">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="mb-1">Balanced Nutrition</h6>
                            <small class="text-muted">For: Mike Johnson</small>
                        </div>
                        <span class="badge bg-warning">Inactive</span>
                    </div>
                </div>
                <div class="card-body">
                    <p class="mb-2"><strong>Duration:</strong> 8 weeks</p>
                    <p class="mb-2"><strong>Daily Calories:</strong> 2,500 kcal</p>
                    <p class="mb-3"><strong>Goal:</strong> General Health</p>
                    <div class="mb-3">
                        <p class="small text-muted mb-2">Macronutrients:</p>
                        <div class="progress mb-2" style="height: 20px;">
                            <div class="progress-bar" style="width: 30%; background-color: #FF6B6B;">30% Protein</div>
                        </div>
                        <div class="progress mb-2" style="height: 20px;">
                            <div class="progress-bar" style="width: 50%; background-color: #4ECDC4;">50% Carbs</div>
                        </div>
                        <div class="progress" style="height: 20px;">
                            <div class="progress-bar" style="width: 20%; background-color: #95E1D3;">20% Fats</div>
                        </div>
                    </div>
                    <div class="d-grid gap-2">
                        <button class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-edit me-1"></i> Edit Plan
                        </button>
                        <button class="btn btn-sm btn-outline-danger">
                            <i class="fas fa-trash me-1"></i> Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Create Diet Plan Modal -->
    <div class="modal fade" id="createDietModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content border-0">
                <div class="modal-header bg-light border-0">
                    <h5 class="modal-title">
                        <i class="fas fa-apple-alt me-2"></i> Create New Diet Plan
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form>
                        <div class="mb-3">
                            <label class="form-label">Client</label>
                            <select class="form-select">
                                <option>Select a client...</option>
                                <option>John Doe</option>
                                <option>Jane Smith</option>
                                <option>Mike Johnson</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Plan Name</label>
                            <input type="text" class="form-control" placeholder="e.g., High Protein Diet">
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Duration (weeks)</label>
                                <input type="number" class="form-control" placeholder="12" min="1">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Daily Calorie Target</label>
                                <input type="number" class="form-control" placeholder="2500" min="1000">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Goal</label>
                            <select class="form-select">
                                <option>Select goal...</option>
                                <option>Muscle Building</option>
                                <option>Weight Loss</option>
                                <option>General Health</option>
                                <option>Performance Enhancement</option>
                                <option>Medical/Therapeutic</option>
                            </select>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Protein %</label>
                                <input type="number" class="form-control" placeholder="30" min="0" max="100">
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Carbs %</label>
                                <input type="number" class="form-control" placeholder="50" min="0" max="100">
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Fats %</label>
                                <input type="number" class="form-control" placeholder="20" min="0" max="100">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Notes</label>
                            <textarea class="form-control" rows="3" placeholder="Add any dietary restrictions or notes..."></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Create Plan
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .card:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.15) !important;
    }

    .progress {
        background-color: #E9ECEF;
    }
</style>
