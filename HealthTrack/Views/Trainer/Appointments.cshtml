@model List<Appointment>

@{
    ViewData["Title"] = "Appointments";
    Layout = "~/Views/Shared/_TrainerLayout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3">Appointments</h1>
            <p class="text-muted">Manage all your scheduled appointments</p>
        </div>
        <a href="/trainer" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i> Back to Dashboard
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>
            No appointments found.
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-calendar-check me-2"></i> All Appointments</h5>
                    <span class="badge bg-primary">@Model.Count appointments</span>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Client Name</th>
                                <th>Start Time</th>
                                <th>End Time</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var apt in Model)
                            {
                                var statusBadge = apt.Status switch
                                {
                                    "Pending" => "warning",
                                    "Approved" => "success",
                                    "Completed" => "info",
                                    "Cancelled" => "danger",
                                    _ => "secondary"
                                };

                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-2" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                                <i class="fas fa-user text-primary"></i>
                                            </div>
                                            <div>
                                                <strong>@(apt.Client?.User?.FirstName ?? "") @(apt.Client?.User?.LastName ?? "")</strong>
                                                <br>
                                                <small class="text-muted">@(apt.Client?.User?.Email ?? "")</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            <i class="fas fa-clock me-1"></i>
                                            @apt.StartTime.ToString("MMM dd, yyyy HH:mm")
                                        </small>
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            @apt.EndTime.ToString("HH:mm")
                                        </small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark">
                                            <i class="fas fa-calendar me-1"></i> Regular
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-@statusBadge">@apt.Status</span>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-primary" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                            @if (apt.Status != "Completed" && apt.Status != "Cancelled")
                                            {
                                                <button type="button" class="btn btn-outline-warning" title="Reschedule">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Pagination -->
        @if ((int?)ViewBag.TotalPages > 1)
        {
            <nav aria-label="Page navigation" class="mt-4">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == (int?)ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" href="/trainer/appointments?page=@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: rgba(91, 79, 163, 0.05);
    }

    .btn-group-sm .btn {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
    }
</style>
