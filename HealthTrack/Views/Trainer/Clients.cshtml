@model List<ClientProfile>

@{
    ViewData["Title"] = "My Clients";
    Layout = "~/Views/Shared/_TrainerLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3">My Assigned Clients</h1>
        <a href="/trainer" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i> Back to Dashboard
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>
            You don't have any assigned clients yet.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var client in Model)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                                    <i class="fas fa-user-circle fa-2x text-primary"></i>
                                </div>
                                <div class="ms-3 flex-grow-1">
                                    <h6 class="mb-0">
                                        @(client.User?.FirstName ?? "") @(client.User?.LastName ?? "")
                                    </h6>
                                    <small class="text-muted">@(client.User?.Email ?? "")</small>
                                </div>
                            </div>

                            <div class="client-details small mb-3">
                                @if (client.DateOfBirth.HasValue)
                                {
                                    <div class="mb-2">
                                        <strong>Age:</strong> 
                                        @((DateTime.UtcNow.Year - client.DateOfBirth.Value.Year)) years
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(client.Gender))
                                {
                                    <div class="mb-2">
                                        <strong>Gender:</strong> @client.Gender
                                    </div>
                                }
                                @if (client.HeightCm.HasValue)
                                {
                                    <div class="mb-2">
                                        <strong>Height:</strong> @client.HeightCm cm
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(client.GoalDescription))
                                {
                                    <div class="mb-2">
                                        <strong>Goal:</strong> @client.GoalDescription
                                    </div>
                                }
                            </div>

                            <div class="d-grid gap-2">
                                <a href="/trainer/clients/@client.ClientProfileID" class="btn btn-primary btn-sm">
                                    <i class="fas fa-eye me-1"></i> View Details
                                </a>
                                <a href="/trainer/clients/@client.ClientProfileID/workouts" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-dumbbell me-1"></i> Workout Plans
                                </a>
                                <a href="/trainer/clients/@client.ClientProfileID/diets" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-apple-alt me-1"></i> Diet Plans
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if ((int?)ViewBag.TotalPages > 1)
        {
            <nav aria-label="Page navigation" class="mt-4">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == (int?)ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" href="/trainer/clients?page=@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>
